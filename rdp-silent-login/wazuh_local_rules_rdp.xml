<!--
  GraySentinel DSOU · "The Silent RDP Login" · Wazuh custom rules (local_rules.xml)
  Author: Eswar Mahalingam · 2026-10-05 · detection only
  Chain: many 4625 (Type 10) -> 4624 Type 10 from non-approved source -> PowerShell in same session
  IDs 100810-100816 (adjust to your free range). Requires Windows Security, Sysmon and
  Microsoft-Windows-PowerShell/Operational channels in the agent's ossec.conf.
-->
<group name="windows,rdp,graysentinel,">

  <!-- 1. Failed RDP logon (Type 10) -->
  <rule id="100810" level="5">
    <if_sid>60122</if_sid>
    <field name="win.system.eventID">^4625$</field>
    <field name="win.eventdata.logonType">^10$</field>
    <description>RDP logon failure for $(win.eventdata.targetUserName) from $(win.eventdata.ipAddress)</description>
    <mitre><id>T1110</id></mitre>
  </rule>

  <!-- 2. Burst: 10+ RDP failures from the same source in 10 min -->
  <rule id="100811" level="10" frequency="10" timeframe="600">
    <if_matched_sid>100810</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>RDP brute force / spray: 10+ failures from $(win.eventdata.ipAddress)</description>
    <mitre><id>T1110.003</id></mitre>
  </rule>

  <!-- 3. Successful RDP logon NOT from the IT jump-host range -->
  <rule id="100812" level="8">
    <if_sid>60106</if_sid>
    <field name="win.eventdata.logonType">^10$</field>
    <field name="win.eventdata.ipAddress" negate="yes">^10\.20\.5\.</field>
    <description>RDP logon by $(win.eventdata.targetUserName) from non-approved source $(win.eventdata.ipAddress)</description>
    <mitre><id>T1021.001</id><id>T1078</id></mitre>
  </rule>

  <!-- 4. Success after burst from same IP within 15 min = likely valid-credential compromise -->
  <rule id="100813" level="12" timeframe="900">
    <if_sid>100812</if_sid>
    <if_matched_sid>100811</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>RDP success after brute force from $(win.eventdata.ipAddress) — investigate valid-account compromise</description>
    <mitre><id>T1110</id><id>T1078</id></mitre>
  </rule>

  <!-- 5. Hidden / encoded PowerShell (Sysmon EID 1) -->
  <rule id="100814" level="9">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\s-enc|\s-encodedcommand|\s-w(indowstyle)?\s+hidden|\s-nop)</field>
    <description>Hidden/encoded PowerShell on $(win.system.computer) by $(win.eventdata.user)</description>
    <mitre><id>T1059.001</id><id>T1027</id></mitre>
  </rule>

  <!-- 6. CHAIN: unusual RDP logon followed by suspicious PowerShell on the same host within 15 min -->
  <rule id="100815" level="14" timeframe="900">
    <if_sid>100814</if_sid>
    <if_matched_sid>100812</if_matched_sid>
    <same_field>win.system.computer</same_field>
    <description>HIGH: Suspicious RDP-to-PowerShell Chain on $(win.system.computer)</description>
    <mitre><id>T1021.001</id><id>T1078</id><id>T1059.001</id></mitre>
  </rule>

  <!-- 7. Script block contains discovery / exfil verbs (4104) -->
  <rule id="100816" level="12">
    <if_sid>91802</if_sid>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?i)(nltest\s+/dclist|domain admins|invoke-webrequest.+-method\s+post|export-csv.+\\users\\public)</field>
    <description>PowerShell script block shows AD discovery or staged upload on $(win.system.computer)</description>
    <mitre><id>T1087.002</id><id>T1482</id><id>T1048</id></mitre>
  </rule>

</group>
